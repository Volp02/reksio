# Reproduzierbarer PlatformIO-Build auf dem Docker-Host (keine lokale Toolchain nötig).
#   docker build -t reksio-pio -f esp/Dockerfile.build esp
#   docker run --rm -e BUILD_FRONTEND=1 -v "$PWD/esp:/src" -v reksio-pio-cache:/root/.platformio reksio-pio \
#     sh -c 'cd frontend && npm ci && cd .. && pio run -e c3-debug'
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/pio && /opt/pio/bin/pip install --no-cache-dir platformio
ENV PATH="/opt/pio/bin:$PATH"
WORKDIR /src
